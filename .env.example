# HelioSolv Environment Configuration
# NOTE: The platform runs fully functional in DEMO MODE when these are empty!

# Supabase PostgreSQL & Auth (Optional for Demo Mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here # (Server-side only if required)

# AI Vision Service (Optional: fallback uses deterministic edge triage algorithms)
# AI_VISION_API_KEY=your-vision-api-key
# AI_VISION_ENDPOINT=https://your-yolov8-or-vision-model-service.com/predict

# Application Mode: "demo" or "production"
NEXT_PUBLIC_APP_MODE=demo
